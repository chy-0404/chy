{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面壳：独立窗口加载本地 Web GUI（http://127.0.0.1:3080），服务未运行时自动拉起",
  "author": "dsh-desktop",
  "packageManager": "npm@11.17.0",
  "workspaces": [],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "error.html",
      "package.json",
      "assets/tray.png",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "DeepSeekHarness-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "DeepSeekHarness-${version}.exe"
    }
  }
}
